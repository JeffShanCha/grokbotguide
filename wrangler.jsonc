{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grokbotguide",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// 只有这两类请求会进入 Worker，其余页面由静态资源直接返回（不计 Worker 调用次数）
		"run_worker_first": ["/", "/api/*"]
	},
	"vars": {
		"GITHUB_REPO": "JeffShanCha/grokbotguide",
		"NOTIFY_TO": "zhuangniuthedev@gmail.com",
		"NOTIFY_FROM": "noreply@grokbotguide.ai"
	}

	// ───────────── 第二步：上线后再打开 ─────────────
	// 下面两个绑定都是可选的。没打开时站点照常运行：复制计数不显示，投稿只建 GitHub Issue、不发邮件。
	// 打开方法：去掉注释，并在上面 "vars" 的右花括号后面加一个逗号。
	//
	// 1) 模板复制计数：Cloudflare 后台 → Storage & Databases → D1 → Create，名字填 grokbotguide，
	//    把 Database ID 填进来。表会在第一次使用时自动创建，不需要跑迁移。
	// "d1_databases": [
	// 	{ "binding": "DB", "database_name": "grokbotguide", "database_id": "<填入 D1 的 ID>", "migrations_dir": "worker/migrations" }
	// ],
	//
	// 2) 投稿邮件通知：要先把 grokbotguide.ai 接入 Cloudflare、开启 Email Routing，并验证下面这个收件地址。
	// "send_email": [{ "name": "NOTIFY", "destination_address": "zhuangniuthedev@gmail.com" }]
	//
	// Secrets（不要写在这里，在 Worker → Settings → Variables and Secrets 里添加）：
	//   GITHUB_TOKEN      只给本仓库 Issues: Read and write 权限的 fine-grained token
	//   TURNSTILE_SECRET  Turnstile 的 Secret Key
}
