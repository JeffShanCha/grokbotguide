{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grokbotguide",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// 只有这两类请求会进入 Worker，其余页面由静态资源直接返回（不计 Worker 调用次数）
		"run_worker_first": ["/", "/api/*"]
	},
	"vars": {
		"GITHUB_REPO": "JeffShanCha/grokbotguide",
		"NOTIFY_TO": "zhuangniuthedev@gmail.com",
		"NOTIFY_FROM": "noreply@grokbotguide.ai"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grokbotguide",
			// 运行 `npx wrangler d1 create grokbotguide` 后把返回的 id 填到这里
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "worker/migrations"
		}
	],
	// 需要先在 Cloudflare 开启 Email Routing 并验证 NOTIFY_TO 这个目标地址
	"send_email": [{ "name": "NOTIFY", "destination_address": "zhuangniuthedev@gmail.com" }]
	// Secrets（不要写在这里）：
	//   npx wrangler secret put GITHUB_TOKEN
	//   npx wrangler secret put TURNSTILE_SECRET
}
