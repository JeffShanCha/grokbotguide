---
// 「实测结果」：还没实测时说明状态并邀请投稿；实测后把这个组件换成 <TestReport>（见 docs/testing-playbook.md）。
import { toLang } from '../i18n/ui';

const route = Astro.locals.starlightRoute;
const lang = toLang(route.locale);
const grade = route.entry.data.grade;
const c = {
	zh: {
		community: '这篇整理自社区作者的公开分享，作者报告跑通过，本站还没有复现。',
		official: '这篇根据官方文档整理，本站还没有按步骤实测。',
		tested: '本站已实测，详见下方记录。',
		cta: '你按步骤跑过？把结果告诉我们',
		hint: '写上测试日期、订阅档位、耗时和和文中不一样的地方，审核后会署名补进这里。',
	},
	en: {
		community: 'This recipe is based on a community author’s published report. The author says it worked; we have not reproduced it yet.',
		official: 'This recipe is compiled from the official docs. We have not run it step by step yet.',
		tested: 'We have tested this recipe; see the record below.',
		cta: 'Ran it yourself? Tell us how it went',
		hint: 'Include the date, your plan, how long it took and anything that differed. We will add it here with credit.',
	},
}[lang];
const text = grade === 'tested' ? c.tested : grade === 'community' ? c.community : c.official;
---

<div class="gbg-test-status not-content">
	<p>{text}</p>
	{
		grade !== 'tested' && (
			<p>
				<a href={`/${lang}/community/submit/`}>{c.cta} →</a>
				<span>{c.hint}</span>
			</p>
		)
	}
</div>

<style>
	.gbg-test-status {
		margin-top: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--gbg-card-border);
		border-radius: 0.75rem;
		background: var(--gbg-card-bg);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.gbg-test-status p {
		margin: 0;
	}
	.gbg-test-status p + p {
		margin-top: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
	}
	.gbg-test-status a {
		color: var(--sl-color-text-accent);
		font-weight: 500;
	}
	.gbg-test-status span {
		color: var(--sl-color-gray-3);
	}
</style>
