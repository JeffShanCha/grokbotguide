---
import { officeBase, gmailGuideUrl, gmailPrompts, mailLabels, officialSources } from '../../data/office-preview';
import CaseBoundaries from '../CaseBoundaries.astro';
import CaseVerification from '../CaseVerification.astro';
import WorkflowPrompt from './WorkflowPrompt.astro';
import GmailPractice from './GmailPractice.astro';
const toc = [
	['result', '先看输入与交付结果'], ['prepare', '准备与能力检查'], ['automation-boundaries', '执行与接管边界'], ['rules', '01 定义分类规则'], ['practice', '02 用合成邮件练习'], ['read-only', '03 只读自己的小批邮件'], ['write', '04 标签与草稿分开验收'], ['repeat', '05 保存 Skill，再设 Routine'], ['troubleshoot', '排错与验收清单'], ['downloads', '下载练习材料'], ['sources', '来源与验证范围'],
];
const problems = [
	['连上账号，却读不到邮件', '核对授权账号、查询条件和当前可用工具。使用 Workspace 时检查管理员策略；不要不断重试或自行换登录路径扩大范围。'],
	['“待付款”和“已付款”混在一起', '先核对邮件是否明确写了已完成交易。把 M03 与 M04 作为一组对照，修正规则后重新跑样例。'],
	['一封邮件命中多个类别', '本教程只给一个流程主标签。关键上下文不足用 Review；保留你原有的其他标签，不批量替换历史分类。'],
	['同一封邮件出现多个草稿', '暂停写草稿，按原邮件 message_id 对照保存的 draft_id，人工核查已有草稿。写入超时不等于没写成功，不直接重试创建。'],
	['会话里有新回复，却被跳过', '按每封原邮件的 message_id 检查，不用 thread_id 作为唯一去重条件。Gmail 的旧标签不会自动覆盖后来的回复。'],
	['正文被截断、附件是判断关键', '标记为 Review，并注明缺失范围。本练习默认不读附件；需要读取时另外明确文件和范围，再判断。'],
	['草稿创建工具不可用', '保留回复文本并写明“未写入 Gmail”。人工复制到草稿箱，不能把页面里的文本当成邮箱已经保存成功。'],
	['今天的邮件超出单次上限', '列出剩余数量或“无法确认余量”，保留待处理队列，下一次继续。不能把截断后的 20 封写成全部邮件。'],
	['Routine 没有发来简报', '先看运行状态，区分“无新内容”与连接失败。核对所属 Bot、时区和下次运行时间，手动试跑后再恢复。'],
];
const checks = ['8 封样例均有结果，标签数量合计为 8；M06 保留为待确认。', 'M03 是待核对账单，M04 是已付收据；没有混淆付款状态。', '只为 M01 与 M08 提供示例草稿；未知交付日期、报价和会议时段没有被确认。', '真实试跑范围可回查到账号、查询条件、原邮件 message_id 和操作结果。', '重复运行同一小批输入，没有重复草稿；失败或部分成功时明确停止位置。', '已发送没有新增邮件；收件箱状态、原有标签和已读状态没有意外改变。'];
---
<div id="main" class="wf-shell">
	<nav class="wf-breadcrumb" data-pagefind-ignore aria-label="面包屑"><a href={officeBase}>办公与信息整理</a><span aria-hidden="true">/</span><span>Gmail 完整教程</span></nav>
	<header class="wf-guide-hero"><div class="wf-kicker">深度教程 / 01</div><h1>Gmail 收件箱整理：<br />从分类到每日简报</h1><p class="wf-lead">先把 8 封样例邮件分清楚，再处理自己的小批邮件。每一步都给出指令、交付物和检查方法，最后再考虑自动运行。</p><div class="wf-guide-meta"><span>shancha 整理</span><span>适合第一次搭建邮件流程</span><span>6 类标签 + 待确认</span></div><div class="wf-actions"><a class="wf-button" href="#result">先看完整样例 ↓</a><a class="wf-text-link" href="#downloads">下载练习材料 ↗</a></div></header>
	<details class="wf-mobile-toc" data-pagefind-ignore><summary>本篇目录</summary><ol>{toc.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}</ol></details>
	<div class="wf-guide-grid">
		<article class="wf-prose">
			<section id="result"><div class="wf-section-title"><span>先看结果</span><h2 id="result-heading">从原始邮件，到你今天要处理的事</h2></div><p>最终留下三种东西：可追溯的分类表、待审阅的回复草稿，以及一页包含待办和例外的简报。先在下面切换查看，确认这是不是你需要的结果。</p><div class="wf-scope"><strong>本页演示范围</strong><p>练习台使用本站编写的合成材料，点击只切换页面内容。最近真实只读预检及阻塞见页末记录；邮件读取、分类、标签写入、草稿保存和 Routine 仍需分别验收。下载材料后，可先让 Bot 在文件上练习。</p></div><GmailPractice /></section>
			<section id="prepare"><div class="wf-section-title"><span>开始前</span><h2 id="prepare-heading">分两段准备：样例练习与真实邮箱</h2></div><div class="wf-two-cards"><div><h3>先练习，不需要邮箱</h3><ul><li>下载 <code>source-mails.json</code> 和 <code>label-rules.md</code>。</li><li>开一个 Bot 对话，上传文件；本阶段只处理附件材料。</li><li>做完再用参考答案对照，调整分类规则。</li></ul></div><div><h3>接入自己的邮箱时</h3><ul><li>通过 Connect apps 添加可用的 Gmail 连接器，由你完成授权。</li><li>先核对账号、工具清单与可见范围；各环境能力可能不同。</li><li>选定一个小范围，首次最多 10 封；先只读，后续再授权写入。</li></ul></div></div><p>官方文档说明连接器可从 Connect apps 安装，并在任务中引用。连接器和云电脑登录可能为账号内多个 Bot 共用；给 Bot 换名字或写一句“只读”并不能建立权限隔离。<a class="wf-source-ref" href={officialSources[0].url} target="_blank" rel="noopener noreferrer">接入说明 ↗</a></p><WorkflowPrompt id="gmail-capability" text={gmailPrompts.capability} title="准备 · 核对 Gmail 连接与工具能力" /><div class="wf-check"><b>检查点</b><p>拿到实际可用/不可用的工具清单。若只有读取能力，就把后续结果保留为文件和文本，由你手动打标签、存草稿。</p></div></section>
			<CaseBoundaries slug="gmail-inbox-triage" />
			<section id="rules" class="wf-stage"><div class="wf-section-title"><span>STEP 01</span><h2 id="rules-heading">先约定怎样分类，再让 Bot 动手</h2></div><p>本教程用 6 个业务标签，加一个 <code>Review</code> 兜底。真实邮箱统一使用 <code>GBG/</code> 前缀，便于识别本流程添加的标签；你原有的标签保留。</p><div class="wf-label-grid">{mailLabels.map(label => <div><span class="wf-tag">{label.name}</span><h3>{label.zh}</h3><p>{label.rule}</p></div>)}</div><div class="wf-note"><strong>多类命中时，按这个顺序判断</strong><p>关键上下文不足 → Review；明确已付款凭证 → Receipts；未处理款项 → Money；然后依次判断 Action、Waiting、Newsletters、Keep。这是本练习的业务约定，Gmail 本身允许多标签。</p></div><p>只给收到的原邮件加业务标签。草稿有自己的状态，不把 <code>GBG/Action</code> 等标签加到草稿上。<a class="wf-source-ref" href={officialSources[5].url} target="_blank" rel="noopener noreferrer">Gmail 标签说明 ↗</a></p><div class="wf-check"><b>检查点</b><p>能解释 M03 为什么是 Money、M04 为什么是 Receipts、M06 为什么需要人工判断，再进入下一步。</p></div></section>
			<section id="practice" class="wf-stage"><div class="wf-section-title"><span>STEP 02</span><h2 id="practice-heading">用 8 封合成邮件，校准第一次结果</h2></div><p>把原始邮件与规则文件一起上传。第一次不要提供参考答案，让 Bot 独立输出分类表；你再回来切换“分类与草稿”对照。M01—M08 是练习编号，之后需要换成真实的 message_id。</p><WorkflowPrompt id="gmail-classify" text={gmailPrompts.classify} title="练习 · 只分类上传的样例邮件" /><div class="wf-check"><b>应拿到什么</b><p>8 行分类结果：Action 2 封，其余六类各 1 封。每行有原文依据和下一步。这里的答案用于校准同一套规则，不代表模型在真实邮箱中的准确率。</p></div><p>如果你希望付款提醒也归 Action，可以修改业务规则；对应的参考答案、草稿策略和简报统计也要一起调整。先把分歧变成明确规则，再重新跑同一组输入。</p></section>
			<section id="read-only" class="wf-stage"><div class="wf-section-title"><span>STEP 03</span><h2 id="read-only-heading">第一次接入真实邮件，只读一小批</h2></div><p>选定自己的账号和查询范围，例如 <code>in:inbox newer_than:2d</code>，最多 10 封。查询结果可能按会话展示，核对单封邮件的接收时间与身份，再按约定计数。<a class="wf-source-ref" href={officialSources[4].url} target="_blank" rel="noopener noreferrer">Gmail 搜索说明 ↗</a></p><div class="wf-note"><strong>后面会用到的三个编号</strong><p><code>message_id</code> 标识一封原邮件，<code>thread_id</code> 标识一段往来会话，<code>draft_id</code> 标识保存的草稿。让 Bot 在结果中返回这些编号，用来追溯操作和避免重复；M01 等样例编号不能直接代入真实邮箱。</p></div><WorkflowPrompt id="gmail-read" text={gmailPrompts.readOnly} title="接入 · 对指定账号和范围只读分类" /><div class="wf-check"><b>检查点</b><p>你能在 Gmail 中找到每一条原邮件。核对分类依据、数量和遗漏项；若稳定 id、完整正文或账号范围不清楚，先停在只读结果。</p></div></section>
			<section id="write" class="wf-stage"><div class="wf-section-title"><span>STEP 04</span><h2 id="write-heading">把“加标签”和“保存草稿”分别验收</h2></div><p>从只读清单中挑 3 封，明确允许哪几个 message_id、哪种动作。一次确认的范围仅用于这次试跑。若环境提供工具级开关，先关闭发送、转发和删除；没有对应控制时，保留人工写入路径。</p><h3>先给原邮件添加标签</h3><WorkflowPrompt id="gmail-labels" text={gmailPrompts.labels} title="写入 · 只给确认过的 3 封邮件加标签" /><div class="wf-check"><b>检查点</b><p>邮箱里出现对应的 GBG/ 标签，原有标签和收件箱状态保留。没有成功添加的邮件在操作记录中单列，不把计划写成完成。</p></div><h3>再起草回复，确认后存入草稿箱</h3><p>只为确实需要你回应的邮件起草。像样例 M08，日历没有核对过，就不能在回复中确认 10:00 或 15:00。你审阅草稿后，再允许保存到 Gmail。</p><WorkflowPrompt id="gmail-drafts" text={gmailPrompts.drafts} title="草稿 · 先展示，再按确认范围保存" /><div class="wf-check"><b>检查点</b><p>在草稿箱打开正文，核对收件人、原会话、语气和未知事项。记录原邮件 message_id 与 draft_id；已发送没有新增。工具无法返回结果时，明确写“未验证保存成功”。</p></div><p>Gmail 的草稿对象与原邮件身份不同；记录 draft_id 有助于识别草稿，不能只用标题判断是否重复。<a class="wf-source-ref" href={officialSources[6].url} target="_blank" rel="noopener noreferrer">Gmail 草稿说明 ↗</a></p></section>
			<section id="repeat" class="wf-stage"><div class="wf-section-title"><span>STEP 05</span><h2 id="repeat-heading">手动跑稳后，保存 Skill，再设 Routine</h2></div><p>先用同一小批输入跑第二次，检查重复标签、重复草稿和失败项是否得到处理。再把已经验收的过程写成可复用方法。官方文档也建议先完成一次可靠的手动任务，再保存与安排重复运行。<a class="wf-source-ref" href={officialSources[1].url} target="_blank" rel="noopener noreferrer">Skill 与 Routine 说明 ↗</a></p><WorkflowPrompt id="gmail-skill" text={gmailPrompts.skill} title="复用 · 保存经过人工验收的 Skill" /><p>第一周可以每天只运行一次，输出留在当前私聊，便于核对。标签写入和草稿保存必须沿用已经明确授权的范围；频率、时区与下一次运行时间都要在创建后复查。</p><WorkflowPrompt id="gmail-routine" text={gmailPrompts.routine} title="定时 · 先审阅 Routine 配置草案" /><div class="wf-check"><b>检查点</b><p>同一封原邮件不会被重复建草稿；同一会话有新回复时仍会检查。上限、分页、重试与部分成功都能在记录中解释；这些依赖实际工具和持久状态，缺少支持时保持手动运行。</p></div></section>
			<section id="troubleshoot"><div class="wf-section-title"><span>日常使用</span><h2 id="troubleshoot-heading">遇到问题，从这里定位</h2></div><div class="wf-faq">{problems.map(([title, body]) => <details><summary>{title}</summary><p>{body}</p></details>)}</div><h3>第一次完整试跑的验收清单</h3><p>这里的勾选只保存在当前页面，供你核对；不会连接邮箱或创建任务。</p><fieldset class="wf-checklist"><legend class="wf-sr-only">邮件流程验收清单</legend>{checks.map((check, i) => <label><input type="checkbox" data-wf-check /><span>{check}</span></label>)}</fieldset><p class="wf-check-progress" role="status" aria-live="polite" data-wf-check-progress>已核对 0 / {checks.length} 项</p></section>
			<section id="downloads"><div class="wf-section-title"><span>练习材料</span><h2 id="downloads-heading">文件可以直接交给 Bot</h2></div><p>先下载输入和规则，练完再看参考答案。所有文件均由本站生成，不包含真实邮件、账号凭据或外部附件。</p><div class="wf-downloads">{[['source-mails.json','原始合成邮件','8 封输入，未包含分类答案'],['label-rules.md','标签规则','6 类业务标签与 Review 兜底'],['expected-results.csv','分类参考答案','逐项核对标签、依据和下一步'],['daily-digest.txt','每日简报样例','输出格式与例外处理'],['practice-prompts.txt','本页全部提示词','7 段分阶段指令']].map(([file,title,description]) => <a href={`${gmailGuideUrl}files/${file}`} download={file}><span><strong>{title}</strong><small>{file} · {description}</small></span><b aria-hidden="true">↓</b></a>)}</div></section>
			<section id="sources"><div class="wf-section-title"><span>来源与范围</span><h2 id="sources-heading">哪些有依据，哪些仍需验证</h2></div><CaseVerification slug="gmail-inbox-triage" /><ul class="wf-source-list">{officialSources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a><p>{source.note}</p></li>)}</ul></section>
			<div class="wf-guide-end"><p>完成邮件整理后，也可以用同样的方法准备会议、阅读长文和梳理群聊。</p><a href={officeBase} class="wf-button">返回办公与信息整理专题 →</a></div>
		</article>
		<aside class="wf-toc" data-pagefind-ignore><div class="wf-kicker">本篇内容</div><ol>{toc.map(([id, title]) => <li><a href={`#${id}`}>{title}</a></li>)}</ol><a href={officeBase} class="wf-toc-back">← 回到办公专题</a></aside>
	</div>
</div>

<script>
	const checks = [...document.querySelectorAll<HTMLInputElement>('[data-wf-check]')];
	const update = () => {
		const progress = document.querySelector('[data-wf-check-progress]');
		if (progress) progress.textContent = `已核对 ${checks.filter(check => check.checked).length} / ${checks.length} 项`;
	};
	checks.forEach(check => check.addEventListener('change', update));
</script>
