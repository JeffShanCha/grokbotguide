---
// 首页：居中搜索式首屏 → 精选案例 → 最新动态 + 常见问题 → 社区。
// 教程、案例和模板的入口都在顶栏下拉菜单里（手机上在侧边菜单里），首页只放最常用的几条路。
// 数量（案例数、问题数等）都从内容里统计，新增页面后自动更新。
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '../../../site.config.mjs';
import sponsors from '../../data/sponsors.json';
import Newsletter from '../Newsletter.astro';
import { formatDate, type Lang } from '../../i18n/ui';
import { localRecipeNavigation } from '../../lib/local-recipe-navigation';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const previewNavigation = await localRecipeNavigation(lang);
const p = (path: string) => `/${lang}/${path}`;

const docs = await getCollection('docs', (e) => e.id.startsWith(`${lang}/`));
const inSection = (s: string) => docs.filter((e) => e.id.startsWith(`${lang}/${s}/`));
const byOrder = <T extends { data: { sidebar: { order?: number } } }>(a: T, b: T) =>
	(a.data.sidebar.order ?? 99) - (b.data.sidebar.order ?? 99);
const n = {
	recipes: inSection('recipes').length,
	bots: inSection('bots').length,
	answers: inSection('answers').length,
};
const questions = inSection('answers').sort(byOrder).slice(0, 4);
const news = (await getCollection('changelog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const featured = await getEntry('docs', `${lang}/recipes/gmail-inbox-triage`);
const featuredPreview = featured ? previewNavigation.entryForId(featured.id) : undefined;
const featuredTested = featured?.data.grade === 'tested';

const copy = {
	zh: {
		eyebrow: '社区共建 · 非官方 · 中英双语',
		title: 'Grok Bot 中文教程、角色模板与自动化工作流',
		tagline: '给自己招一个不下班的 AI 同事',
		lead: 'Grok Bot 中文实战手册。教程、案例和模板都收在上面的菜单里，也可以直接搜。每篇都标注来源、验证状态与更新时间。',
		search: '想让 Bot 帮你做什么？比如：整理 Gmail、每天巡检网站',
		hotLabel: '常搜：',
		hot: [
			['订阅怎么选', 'answers/grok-bot-vs-cursor-plans/'],
			['连接 Gmail', 'answers/how-to-connect-grok-bot-to-gmail/'],
			['定时任务', 'answers/how-to-schedule-grok-bot-routines/'],
			['国内能用吗', 'answers/grok-bot-in-china/'],
		],
		ctaPrimary: '30 分钟上手 →',
		ctaSecondary: `看 ${n.recipes} 个实战案例`,
		stats: `${n.recipes} 个实战案例 · ${n.answers} 个常见问题 · ${n.bots} 张角色卡 · 开源在 GitHub`,
		featuredBadge: '本周精选',
		featuredLead: '每天两次扫一遍收件箱：分类打标签、起草回复，把需要你处理的事列成简报。发送这一步始终留给你。',
		featuredStatus: '✓ 本站实测',
		featuredCta: '看完整步骤 →',
		shotTitle: 'Bot 每天发给你的简报包含',
		shotItems: ['今天需要你处理的事', '涉及钱的邮件', '等你审阅的回复草稿', '已归档的邮件数量'],
		shotCta: '看给 Bot 的完整指令 →',
		newsTitle: '最新动态',
		newsMore: '全部 →',
		faqTitle: '常见问题',
		faqMore: '全部问题 →',
		communityTitle: '一起把 Grok Bot 用明白',
		communityLead: '每日动态、实战答疑、模板首发在知识星球。投稿一篇实测，署名并链接到你的主页。',
		communityCta: '加入知识星球',
		communityCta2: '投稿',
		sponsorsTitle: '赞助商',
	},
	en: {
		eyebrow: 'Community-built · Unofficial · English & Chinese',
		title: 'Grok Bot Guides, Templates & Automation Workflows',
		tagline: 'Hire an AI teammate that never clocks out',
		lead: 'A hands-on Grok Bot handbook. Guides, recipes and templates are in the menu above, or just search. Every page shows its sources, verification status and last update.',
		search: 'What should your Bot do? e.g. triage Gmail, check my website daily',
		hotLabel: 'Popular:',
		hot: [
			['Which plan', 'answers/grok-bot-vs-cursor-plans/'],
			['Connect Gmail', 'answers/how-to-connect-grok-bot-to-gmail/'],
			['Schedule routines', 'answers/how-to-schedule-grok-bot-routines/'],
			['Is it safe?', 'answers/is-grok-bot-safe/'],
		],
		ctaPrimary: 'Start in 30 minutes →',
		ctaSecondary: `Browse ${n.recipes} recipes`,
		stats: `${n.recipes} recipes · ${n.answers} how-to answers · ${n.bots} Bot cards · open source on GitHub`,
		featuredBadge: 'Featured this week',
		featuredLead: 'Twice a day the Bot sweeps your inbox: labels mail, drafts replies and sends you a briefing of what needs you. Sending always stays with you.',
		featuredStatus: '✓ Tested here',
		featuredCta: 'See all the steps →',
		shotTitle: 'The daily briefing from your Bot covers',
		shotItems: ['What needs you today', 'Emails involving money', 'Reply drafts waiting for review', 'How many emails were archived'],
		shotCta: 'See the full prompt →',
		newsTitle: 'Latest updates',
		newsMore: 'All →',
		faqTitle: 'Common questions',
		faqMore: 'All questions →',
		communityTitle: 'Stay in the loop',
		communityLead: 'New guides and templates by email, on X, or by watching the repo. Share a test run and get credited.',
		communityCta: 'Follow on X',
		communityCta2: 'Share a test run',
		sponsorsTitle: 'Sponsors',
	},
}[lang];
if (previewNavigation.enabled) {
 Object.assign(copy, lang === 'zh' ? {
  ctaSecondary: `看 ${previewNavigation.total} 篇完整版教程`,
  featuredLead: '从 8 封合成邮件练起：逐项对照分类、回复草稿和每日简报，再按步骤核对自己的 Gmail。每个阶段都有提示词、材料与验收方法。',
  shotTitle: '完整教程里可以直接查看',
  shotItems: ['邮件分类与判断依据', '两份待审阅回复草稿', '每日简报和待确认事项', '完整提示词与练习文件'],
 } : {
  ctaSecondary: `Explore ${previewNavigation.total} complete tutorials`,
  featuredLead: 'Start with eight synthetic emails. Compare classifications, reply drafts and a daily brief, then validate a small batch in your own Gmail. Every stage includes prompts, materials and acceptance checks.',
  shotTitle: 'Explore the complete tutorial',
  shotItems: ['Email classifications and evidence', 'Two reply drafts for review', 'A daily brief with exceptions', 'Complete prompts and practice files'],
 });
}
---

<div id="_top" class="not-content gbg-home">
	<!-- 1. 首屏：搜索 -->
	<section class:list={['hero', lang]}>
		<p class="eyebrow">{copy.eyebrow}</p>
		{
			lang === 'zh' ? (
				/* 中文标题文字不变，只拆成两行排版；「、」放进视觉隐藏的 span，保证标题文本完整 */
				<h1 class="zh-title"><span class="l1">Grok Bot 中文教程</span><span class="sr-only">、</span><span class="l2">角色模板<span class="em">与</span>自动化工作流</span></h1>
			) : (
				<h1>{copy.title}</h1>
			)
		}
		<p class="tagline">{copy.tagline}</p>
		<p class="lead">{copy.lead}</p>
		<button type="button" class="big-search" data-open-search>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			</svg>
			<span>{copy.search}</span>
			<kbd>Ctrl K</kbd>
		</button>
		<p class="hot">
			<span>{copy.hotLabel}</span>
			{copy.hot.map(([label, href]) => <a href={p(href)}>{label}</a>)}
		</p>
		<div class="actions">
			<a class="btn btn-primary" href={p('guide/')}>{copy.ctaPrimary}</a>
			<a class="btn" href={p('recipes/')}>{copy.ctaSecondary}</a>
		</div>
		<p class="stats">{copy.stats}</p>
		{previewNavigation.enabled && <p class="stats" data-recipe-preview-entry><a style="color:var(--sl-color-text-accent)" href={previewNavigation.overviewHref}>{lang === 'zh' ? '按五个专题浏览全部完整版教程 →' : 'Browse all complete tutorials across five topics →'}</a></p>}
	</section>

	<!-- 2. 精选案例 -->
	{
		featured && (
			<section class="featured">
				<div class="featured-copy">
					<span class="badge-soft">{copy.featuredBadge}</span>
					<h2>{featuredPreview?.title || featured.data.title}</h2>
					<p>{copy.featuredLead}</p>
					<div class="gbg-tags">
						{(featuredPreview ? ['Gmail'] : featured.data.apps).map((app) => (
							<span class="gbg-badge">{app}</span>
						))}
						{featuredTested && <span class="gbg-badge gbg-grade-tested">{copy.featuredStatus}</span>}
					</div>
					<a class="btn btn-outline" href={previewNavigation.href(`/${featured.id}/`)}>
						{copy.featuredCta}
					</a>
				</div>
				<figure class="shot">
					<div class="shot-box">
						<strong>{copy.shotTitle}</strong>
						<ul>
							{copy.shotItems.map((x) => (
								<li>{x}</li>
							))}
						</ul>
						<a href={previewNavigation.enabled ? `${previewNavigation.href(`/${featured.id}/`)}#practice` : `/${featured.id}/${lang === 'zh' ? '#给-bot-的指令' : '#prompt'}`}>{copy.shotCta}</a>
					</div>
				</figure>
			</section>
		)
	}

	<!-- 3. 最新动态 + 常见问题 -->
	<section class="two-col">
		<div class="news">
			<div class="section-head">
				<h2>{copy.newsTitle}</h2>
				<a href={p('news/changelog/')}>{copy.newsMore}</a>
			</div>
			<ul>
				{
					news.map((item) => (
						<li>
							<time datetime={item.data.date.toISOString()}>{formatDate(item.data.date, lang)}</time>
							<a href={item.data.url} rel="noopener">
								{lang === 'zh' ? item.data.zh : item.data.en}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="faq">
			<div class="section-head">
				<h2>{copy.faqTitle}</h2>
				<a href={p('answers/')}>{copy.faqMore}</a>
			</div>
			<ul>
				{
					questions.map((e) => (
						<li>
							<a href={`/${e.id}/`}>{e.data.title}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- 4. 社区 -->
	<section class="community">
		<div class="community-copy">
			<h2>{copy.communityTitle}</h2>
			<p>{copy.communityLead}</p>
			{lang === 'en' && <Newsletter variant="compact" />}
		</div>
		<div class="actions">
			<a class="btn btn-accent" href={lang === 'zh' ? SITE.zsxq : SITE.x}>
				{copy.communityCta}
			</a>
			<a class="btn btn-ghost" href={p('community/submit/')}>
				{copy.communityCta2}
			</a>
		</div>
	</section>

	{
		sponsors.length > 0 && (
			<section>
				<h2>{copy.sponsorsTitle}</h2>
				<div class="sponsors">
					{sponsors.map((s: { name: string; url: string; logo?: string }) => (
						<a href={s.url} rel="sponsored noopener">
							{s.logo ? <img src={s.logo} alt={s.name} height="32" /> : s.name}
						</a>
					))}
				</div>
			</section>
		)
	}
</div>

<script>
	// 首屏的大搜索框：打开 Starlight 自带的搜索弹窗
	document.querySelectorAll<HTMLButtonElement>('[data-open-search]').forEach((b) =>
		b.addEventListener('click', (e) => {
			// 先让这次点击结束，再打开弹窗，避免被弹窗的「点外面就关闭」逻辑立刻关掉
			e.stopPropagation();
			requestAnimationFrame(() => document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click());
		})
	);
</script>

<style>
	.gbg-home {
		display: flex;
		flex-direction: column;
		gap: 4rem;
		padding-block: 0 2rem;
	}
	.gbg-home :is(h1, h2) {
		font-family: var(--gbg-display);
		color: var(--sl-color-white);
		margin: 0;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 3rem;
		padding: 0 1.5rem;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-hairline-shade);
		color: var(--sl-color-white);
		text-decoration: none;
		font-weight: 500;
	}
	.btn:hover {
		border-color: var(--sl-color-gray-4);
	}
	.btn-primary {
		background: var(--sl-color-white);
		border-color: var(--sl-color-white);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	.btn-primary:hover {
		border-color: var(--sl-color-white);
		opacity: 0.9;
	}
	.btn-outline {
		align-self: flex-start;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		border-color: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
		color: var(--sl-color-text-accent);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	/* 1. 首屏 */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 4.5rem 0 1rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.06em;
		color: var(--sl-color-text-accent);
	}
	.hero h1 {
		max-width: 60rem;
		font-size: clamp(2rem, 4.6vw, 3.25rem);
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	.tagline {
		margin: 0.85rem 0 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.lead {
		margin: 1rem 0 0;
		max-width: 40rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	/* 中文首屏排版（英文版不受影响） */
	.hero.zh .eyebrow {
		letter-spacing: 0;
	}
	.hero.zh h1.zh-title {
		max-width: none;
		margin: 0;
		font-family: 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
		font-size: 56px;
		font-weight: 700;
		line-height: 1.22;
		letter-spacing: 0;
	}
	.zh-title .l1,
	.zh-title .l2 {
		display: block;
		white-space: nowrap;
	}
	.zh-title .em {
		color: #c2410c;
	}
	:root:not([data-theme='light']) .zh-title .em {
		color: var(--sl-color-text-accent);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.hero.zh .tagline {
		margin: 22px 0 0;
		font-size: 22px;
		font-weight: 500;
		color: #3f3f46;
	}
	:root:not([data-theme='light']) .hero.zh .tagline {
		color: var(--sl-color-gray-2);
	}
	.hero.zh .lead {
		max-width: 32em;
		font-size: 17px;
		color: #71717a;
		text-wrap: pretty;
	}
	:root:not([data-theme='light']) .hero.zh .lead {
		color: var(--sl-color-gray-3);
	}
	.big-search {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		width: 100%;
		max-width: 37.5rem;
		min-height: 3.5rem;
		margin-top: 2rem;
		padding: 0 1rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.9rem;
		background: var(--sl-color-black);
		box-shadow: 0 4px 16px rgba(24, 24, 27, 0.06);
		color: var(--sl-color-gray-3);
		font: inherit;
		text-align: start;
		cursor: text;
	}
	.big-search:hover {
		border-color: var(--sl-color-gray-4);
	}
	.big-search span {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.big-search kbd {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		padding: 0 0.35rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.3rem;
	}
	.hot {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		margin: 1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.hot a {
		padding: 0.15rem 0.75rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.hot a:hover {
		color: var(--sl-color-white);
	}
	.hero .actions {
		justify-content: center;
		margin-top: 2rem;
	}
	.stats {
		margin: 1.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	/* 2. 精选案例 */
	.featured {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
		gap: 2rem;
		padding: 2.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1.25rem;
		background: var(--gbg-soft-bg);
	}
	.featured-copy {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-width: 0;
	}
	.featured h2 {
		font-size: var(--sl-text-2xl);
		font-weight: 600;
		line-height: 1.35;
	}
	.featured p {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.featured .gbg-tags {
		margin: 0;
		padding: 0;
	}
	.badge-soft {
		align-self: flex-start;
		font-size: var(--sl-text-xs);
		padding: 0.1rem 0.65rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-weight: 500;
	}
	.shot {
		margin: 0;
		display: flex;
		min-width: 0;
	}
	.shot-box {
		flex: 1;
		min-height: 15rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.75rem;
		padding: 1.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.9rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.shot-box ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.shot-box li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.55rem 0.75rem;
		border-radius: 0.5rem;
		background: var(--gbg-soft-bg);
		color: var(--sl-color-gray-1);
	}
	.shot-box li::before {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--sl-color-accent);
	}
	.shot-box strong {
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-base);
	}
	.shot-box a,
	.section-head a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	/* 3. 动态 + 问题 */
	.two-col {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 2.5rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}
	.section-head h2 {
		font-size: var(--sl-text-xl);
		font-weight: 600;
	}
	.section-head a {
		font-size: var(--sl-text-sm);
		white-space: nowrap;
	}
	.news ul,
	.faq ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.news ul {
		border-top: 1px solid var(--sl-color-hairline);
	}
	.news li {
		display: flex;
		gap: 1.25rem;
