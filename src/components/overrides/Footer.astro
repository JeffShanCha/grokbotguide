---
import Default from '@astrojs/starlight/components/Footer.astro';
import CompleteTutorialLinks from '../workflow-en/CompleteTutorialLinks.astro';
import { faqTutorials } from '../../data/workflow-en/entry-points';
import { SITE } from '../../../site.config.mjs';
import { formatDate, toLang, useT } from '../../i18n/ui';
import { getCollection } from 'astro:content';

const route = Astro.locals.starlightRoute;
const data = route.entry.data;
const lang = toLang(route.locale);
const t = useT(lang);
const sources = data.sources ?? [];
// 参考来源上方的中性说明：日期优先用 last_checked，其次 last_verified，最后用页面最后更新日期
const basisDate = data.last_checked ?? data.last_verified ?? route.lastUpdated;
const [basisBefore, basisAfter] = basisDate ? t('meta.basis').split('{date}') : [t('meta.basisNoDate'), ''];
const section = route.entry.id.split('/')[1];
const faqSlug = route.entry.id.split('/')[2];
const showCollected = ['start', 'advanced', 'recipes', 'bots', 'templates', 'news'].includes(section);
// 外部资料只显示一行链接，完整列表在资源导航里按分类筛选
const collected = showCollected && route.entry.id !== `${lang}/${section}`
	? (await getCollection('resources')).filter((r) => r.data.categories.includes(section as 'recipes')).length
	: 0;
---

{lang === 'en' && section === 'answers' && <CompleteTutorialLinks slugs={faqTutorials[faqSlug || ''] ?? ['gmail-inbox-triage','summarize-a-document','website-daily-check']} />}

{
	sources.length > 0 && (
		<section class="gbg-sources">
		<p class="gbg-basis">
			{basisBefore}
			{basisDate ? <time datetime={basisDate.toISOString()}>{formatDate(basisDate, lang)}</time> : null}
			{basisAfter}
			<a href={`/${lang}/community/submit/`}>{t('meta.feedback')}</a>
			{route.editUrl && <a href={route.editUrl.href}>{t('meta.editPage')}</a>}
		</p>
		<details>
			<summary>
				{t('meta.sources')}{lang === 'zh' ? `（${sources.length}）` : ` (${sources.length})`}
			</summary>
			<ul>
				{sources.map((s) => (
					<li>
						<a href={s.url} rel="noopener">
							{s.title}
						</a>
					</li>
				))}
			</ul>
		</details>
		</section>
	)
}

{showCollected && collected > 0 && (
	<p class="gbg-collected">
		<a href={`/${lang}/resources/?category=${section}`}>
			{lang === 'zh' ? `相关外部资料 ${collected} 条 →` : `${collected} related external resources →`}
		</a>
		<span>{lang === 'zh' ? '官方资料和原作者分享，每条附核验范围说明。' : 'Official sources and original authors’ posts, each with a note on what was checked.'}</span>
	</p>
)}

<Default />

<div class="gbg-footer">
	<p>{t('footer.disclaimer')}</p>
	<p class="gbg-footer-links">
		<a href={`/${lang}/community/about/`}>{t('footer.about')}</a>
		<a href={`mailto:${SITE.email.takedown}`}>{t('footer.takedown')}</a>
		<a href={SITE.repo}>GitHub</a>
		<span>{t('footer.license')}</span>
	</p>
</div>

<style>
	.gbg-collected {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.gbg-collected a {
		color: var(--sl-color-text-accent);
		font-weight: 500;
	}
	.gbg-sources {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.gbg-basis {
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.gbg-basis a {
		margin-inline-start: 0.6rem;
		color: var(--sl-color-text-accent);
	}
	.gbg-sources summary {
		cursor: pointer;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
	}
	.gbg-sources ul {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.9;
	}
	.gbg-sources ul {
		padding-inline-start: 1.25rem;
		font-size: var(--sl-text-sm);
	}
	.gbg-footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gbg-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 0.5rem;
	}
	.gbg-footer a {
		color: var(--sl-color-gray-2);
	}
</style>
