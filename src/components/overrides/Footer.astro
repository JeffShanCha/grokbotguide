---
import Default from '@astrojs/starlight/components/Footer.astro';
import { SITE } from '../../../site.config.mjs';
import { toLang, useT } from '../../i18n/ui';
import { getCollection } from 'astro:content';

const route = Astro.locals.starlightRoute;
const data = route.entry.data;
const lang = toLang(route.locale);
const t = useT(lang);
const sources = data.sources ?? [];
const section = route.entry.id.split('/')[1];
const showCollected = ['start', 'advanced', 'recipes', 'bots', 'templates', 'news'].includes(section);
// 外部资料只显示一行链接，完整列表在资源导航里按分类筛选
const collected = showCollected && route.entry.id !== `${lang}/${section}`
	? (await getCollection('resources')).filter((r) => r.data.categories.includes(section as 'recipes')).length
	: 0;
---

{
	sources.length > 0 && (
		<section class="gbg-sources">
			<h2>{t('meta.sources')}</h2>
			<ul>
				{sources.map((s) => (
					<li>
						<a href={s.url} rel="noopener">
							{s.title}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

{showCollected && collected > 0 && (
	<p class="gbg-collected">
		<a href={`/${lang}/resources/?category=${section}`}>
			{lang === 'zh' ? `相关外部资料 ${collected} 条 →` : `${collected} related external resources →`}
		</a>
		<span>{lang === 'zh' ? '官方资料和作者分享，来源核验不等于本站实测。' : 'Official sources and author write-ups; a checked source is not a test by us.'}</span>
	</p>
)}

<Default />

<div class="gbg-footer">
	<p>{t('footer.disclaimer')}</p>
	<p class="gbg-footer-links">
		<a href={`/${lang}/community/about/`}>{t('footer.about')}</a>
		<a href={`mailto:${SITE.email.takedown}`}>{t('footer.takedown')}</a>
		<a href={SITE.repo}>GitHub</a>
		<span>{t('footer.license')}</span>
	</p>
</div>

<style>
	.gbg-collected {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.gbg-collected a {
		color: var(--sl-color-text-accent);
		font-weight: 500;
	}
	.gbg-sources {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.gbg-sources h2 {
		font-size: var(--sl-text-lg);
		margin-bottom: 0.5rem;
	}
	.gbg-sources ul {
		padding-inline-start: 1.25rem;
		font-size: var(--sl-text-sm);
	}
	.gbg-footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gbg-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 0.5rem;
	}
	.gbg-footer a {
		color: var(--sl-color-gray-2);
	}
</style>
