---
// 深浅色切换：一个图标按钮。浅色时显示月亮（点了变深色），深色时显示太阳。
// 选择存进 localStorage 的 starlight-theme，和 Starlight 自带的主题逻辑共用。
const lang = Astro.locals.starlightRoute.locale === 'zh' ? 'zh' : 'en';
const label = lang === 'zh' ? '切换深色或浅色' : 'Toggle dark or light mode';
---

<gbg-theme-toggle>
	<button type="button" class="gbg-theme-btn" aria-label={label} title={label}>
		<svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
		</svg>
		<svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</svg>
	</button>
</gbg-theme-toggle>

<script>
	const storageKey = 'starlight-theme';
	class GbgThemeToggle extends HTMLElement {
		connectedCallback() {
			const btn = this.querySelector('button')!;
			const sync = () => btn.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
			sync();
			btn.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem(storageKey, next);
				} catch {}
				document.querySelectorAll('gbg-theme-toggle button').forEach((b) => b.setAttribute('aria-pressed', String(next === 'dark')));
			});
			// 没手动选过时，跟随系统
			matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
				let saved = '';
				try {
					saved = localStorage.getItem(storageKey) ?? '';
				} catch {}
				if (!saved) {
					document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
					sync();
				}
			});
		}
	}
	customElements.define('gbg-theme-toggle', GbgThemeToggle);
</script>

<style>
	.gbg-theme-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: transparent;
		color: #52525b;
		cursor: pointer;
	}
	.gbg-theme-btn:hover {
		background: #f4f4f5;
	}
	:global(:root[data-theme='dark']) .gbg-theme-btn {
		color: #a1a1aa;
	}
	:global(:root[data-theme='dark']) .gbg-theme-btn:hover {
		background: #27272a;
		color: #e4e4e7;
	}
	.sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}
</style>
