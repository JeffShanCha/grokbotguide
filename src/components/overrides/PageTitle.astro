---
// 文章标题区：面包屑和阅读进度 → 标题 → 来源与实测状态、作者、核对日期、阅读时间 → 实战案例摘要格 → 轻量提示。
import { getCollection } from 'astro:content';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { formatDate, toLang, useT } from '../../i18n/ui';

const route = Astro.locals.starlightRoute;
const data = route.entry.data;
const lang = toLang(route.locale);
const t = useT(lang);
const isSplash = data.template === 'splash';
const section = route.id.split('/')[1] ?? '';
const isIndex = route.id === `${lang}/${section}`;

// 面包屑：所在栏目；快速上手、进阶教程额外显示「第 N 篇，共 M 篇」和进度条
const SECTIONS: Record<string, { zh: string; en: string; href: string }> = {
	start: { zh: '快速上手', en: 'Get started', href: 'guide/#start' },
	advanced: { zh: '进阶教程', en: 'Advanced', href: 'guide/#advanced' },
	recipes: { zh: '实战案例', en: 'Recipes', href: 'recipes/' },
	bots: { zh: '角色卡', en: 'Bot cards', href: 'bots/' },
	templates: { zh: '模板', en: 'Templates', href: 'templates/' },
	answers: { zh: '常见问题', en: 'How-to & FAQ', href: 'answers/' },
	community: { zh: '社区', en: 'Community', href: 'community/about/' },
	news: { zh: '更新', en: 'News', href: 'news/changelog/' },
};
const crumb = !isSplash && !isIndex ? SECTIONS[section] : undefined;
let progress: { i: number; n: number } | undefined;
if (crumb && (section === 'start' || section === 'advanced')) {
	const list = (await getCollection('docs', (e) => e.id.startsWith(`${lang}/${section}/`))).sort(
		(a, b) => (a.data.sidebar.order ?? 99) - (b.data.sidebar.order ?? 99)
	);
	const i = list.findIndex((e) => e.id === route.id);
	if (i >= 0) progress = { i: i + 1, n: list.length };
}

// 阅读时间：中文每分钟约 400 字，英文约 200 词
const text = (route.entry.body ?? '').replace(/```[\s\S]*?```/g, ' ').replace(/^import .*$/gm, '').replace(/<[^>]+>/g, ' ');
const minutes = Math.max(1, Math.round(lang === 'zh' ? text.replace(/\s/g, '').length / 400 : text.split(/\s+/).filter(Boolean).length / 200));
const c = {
	zh: { step: (i: number, n: number) => `第 ${i} 篇，共 ${n} 篇`, pending: '待实测', read: `阅读约 ${minutes} 分钟`, checked: '最后核对', updated: '更新于', edit: '发现不一致？在 GitHub 上修改这一页' },
	en: { step: (i: number, n: number) => `Page ${i} of ${n}`, pending: 'Not tested yet', read: `${minutes} min read`, checked: 'Last checked', updated: 'Updated', edit: 'Something differs? Edit this page on GitHub' },
}[lang];
const showMeta = !isSplash && !isIndex && (data.grade || data.author);
const dateLabel = data.last_verified ? c.checked : c.updated;
const date = data.last_verified ?? route.lastUpdated;

// 实战案例文章：标题下的摘要格
const isRecipe = /^[a-z]+\/recipes\/.+/.test(route.id);
const summary = isRecipe
	? [
			{ k: t('sum.who'), v: data.role ? t(`role.${data.role}`) : '' },
			{ k: t('sum.apps'), v: data.apps.join(' · ') },
			{ k: t('sum.risk'), v: data.risk ? t(`risk.${data.risk}`) : '', cls: data.risk ? `risk-${data.risk}` : '' },
			{ k: t('sum.cadence'), v: data.cadence ? t(`cadence.${data.cadence}`) : '' },
			{ k: t('sum.difficulty'), v: data.difficulty ? t(`difficulty.${data.difficulty}`) : '' },
		].filter((x) => x.v)
	: [];
---

{
	crumb && (
		<div class="gbg-crumb">
			<a href={`/${lang}/${crumb.href}`}>{crumb[lang]}</a>
			{progress && (
				<>
					<span aria-hidden="true">/</span>
					<span>{c.step(progress.i, progress.n)}</span>
					<span class="bar" aria-hidden="true">
						{Array.from({ length: progress.n }, (_, k) => (
							<i class:list={{ on: k < progress!.i }} />
						))}
					</span>
				</>
			)}
		</div>
	)
}

{/* 首页（splash）由 Home 组件自己渲染 h1，这里不再重复标题 */}
{!isSplash && <Default />}

{
	showMeta && (
		<div class="gbg-meta">
			{data.grade && <span class={`gbg-badge gbg-grade-${data.grade}`}>{t(`grade.${data.grade}`)}</span>}
			{data.needs_testing && <span class="gbg-badge gbg-pending">{c.pending}</span>}
			{data.author && (
				<span>
					{t('meta.author')} <a href={`https://github.com/${data.author}`}>@{data.author}</a>
				</span>
			)}
			{date && (
				<>
					<span class="sep" aria-hidden="true">|</span>
					<span>
						{dateLabel} <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
					</span>
				</>
			)}
			<span class="sep" aria-hidden="true">|</span>
			<span>{c.read}</span>
		</div>
	)
}

{
	summary.length > 0 && (
		<dl class="gbg-summary">
			{summary.map((x) => (
				<div>
					<dt>{x.k}</dt>
					<dd class={x.cls}>{x.v}</dd>
				</div>
			))}
		</dl>
	)
}

{
	!isSplash && !isIndex && data.needs_testing && (
		<p class="gbg-needs-testing" role="note">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
				<circle cx="12" cy="12" r="9" />
				<path d="M12 11v5M12 8h.01" />
			</svg>
			<span>
				{t('meta.needsTesting')} {route.editUrl && <a href={route.editUrl.href}>{c.edit}</a>}
			</span>
		</p>
	)
}

<style>
	.gbg-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.gbg-summary {
		display: flex;
		flex-wrap: wrap;
		gap: 1px;
		margin: 1.25rem 0 0;
		border: 1px solid var(--gbg-card-border);
		border-radius: 0.75rem;
		background: var(--gbg-card-border);
		overflow: hidden;
	}
	.gbg-summary div {
		flex: 1 1 9rem;
		padding: 0.7rem 0.9rem;
		background: var(--gbg-card-bg);
	}
	.gbg-summary dt {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.gbg-summary dd {
		margin: 0.15rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		line-height: 1.45;
	}
	.gbg-summary .risk-low::before,
	.gbg-summary .risk-medium::before,
	.gbg-summary .risk-high::before {
		content: '';
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-inline-end: 0.4rem;
		border-radius: 50%;
		vertical-align: 0.05rem;
	}
	.gbg-summary .risk-low::before {
		background: #16a34a;
	}
	.gbg-summary .risk-medium::before {
		background: #d97706;
	}
	.gbg-summary .risk-high::before {
		background: #dc2626;
	}
	.gbg-crumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.75rem;
		margin-bottom: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.gbg-crumb a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.gbg-crumb a:hover {
		color: var(--sl-color-white);
	}
	.gbg-crumb .bar {
		display: inline-flex;
		gap: 3px;
	}
	.gbg-crumb .bar i {
		width: 1.35rem;
		height: 4px;
		border-radius: 2px;
		background: var(--sl-color-gray-5);
	}
	.gbg-crumb .bar i.on {
		background: var(--sl-color-accent);
	}
	.gbg-meta .sep {
		color: var(--sl-color-gray-5);
	}
	.gbg-needs-testing {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		margin: 1.25rem 0 0;
		padding: 0.75rem 0.9rem;
		border-radius: 0.65rem;
		background: var(--gbg-soft-bg);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.gbg-needs-testing svg {
		flex: none;
		margin-top: 0.1rem;
		color: var(--sl-color-gray-3);
	}
	.gbg-needs-testing a {
		color: var(--sl-color-text-accent);
	}
</style>
