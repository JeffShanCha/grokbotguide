---
// 包一层 Starlight 自带的语言切换器：用户手动切换时写入 lang Cookie，
// 之后访问根路径 / 时 Worker 会优先使用这个选择，而不是按地区判断。
import Default from '@astrojs/starlight/components/LanguageSelect.astro';
---

<Default />

<script>
	// 在捕获阶段注册：先于 Starlight 自带的跳转逻辑执行，保证 Cookie 和统计事件在跳转前完成
	document.querySelectorAll('starlight-lang-select').forEach((el) => {
		el.addEventListener(
			'change',
			(e) => {
				const select = e.target as HTMLSelectElement;
				const lang = select.value.startsWith('/en/') ? 'en' : 'zh';
				document.cookie = `lang=${lang}; path=/; max-age=31536000; samesite=lax`;
				window.gtag?.('event', 'switch_language', { language: lang, transport_type: 'beacon' });
			},
			{ capture: true }
		);
	});
</script>
