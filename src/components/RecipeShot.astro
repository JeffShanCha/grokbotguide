---
// 「你会得到什么」：src/assets/tests/<slug>/result.(png|jpg|webp) 存在时显示结果截图，否则用一段文字说明交付物。
// 截图放进去、重新构建就会自动替换，不用改文章。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toLang } from '../i18n/ui';

interface Props {
	slug: string;
}
const { slug } = Astro.props;
const lang = toLang(Astro.locals.starlightRoute.locale);
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/tests/*/result.{png,jpg,jpeg,webp}', { eager: true });
const key = Object.keys(shots).find((k) => k.startsWith(`/src/assets/tests/${slug}/`));
const img = key ? shots[key].default : undefined;
const description = Astro.locals.starlightRoute.entry.data.description ?? '';
const c = {
	zh: { alt: 'Bot 交付的结果截图', cta: '有运行截图？欢迎分享' },
	en: { alt: 'Screenshot of what the Bot delivered', cta: 'Have a screenshot of your run? Share it' },
}[lang];
---

{
	img ? (
		<figure class="gbg-shot">
			<Image src={img} alt={c.alt} />
		</figure>
	) : (
		<div class="gbg-shot-empty not-content">
			<p>{description}</p>
			<a href={`/${lang}/community/submit/`}>{c.cta} →</a>
		</div>
	)
}

<style>
	.gbg-shot img {
		border-radius: 0.75rem;
		border: 1px solid var(--gbg-card-border);
	}
	.gbg-shot-empty {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.75rem;
		background: var(--gbg-soft-bg);
		color: var(--sl-color-gray-2);
	}
	.gbg-shot-empty p {
		margin: 0;
	}
	.gbg-shot-empty a {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}
</style>
